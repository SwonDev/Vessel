From 89b55e1613b1fcac9a1c071acd48ade025affd0b Mon Sep 17 00:00:00 2001
From: Swon <aperdel.esi@gmail.com>
Date: Thu, 2 Jul 2026 13:18:35 +0100
Subject: [PATCH] vessel: parches DXMT winemac (client_view helper + fix foco,
 estado validado 2026-07-01)

---
 dlls/winemac.drv/macdrv.h       |  2 +-
 dlls/winemac.drv/macdrv_cocoa.h | 10 ++---
 dlls/winemac.drv/window.c       | 70 ++++++++++++++++++++++++++++++---
 3 files changed, 70 insertions(+), 12 deletions(-)

diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index 6316a096..814db010 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -204,7 +204,7 @@ extern BOOL macdrv_SystemParametersInfo(UINT action, UINT int_param, void *ptr_p
     return CONTAINING_RECORD(client, struct macdrv_client_surface, client);
 }
 
-extern struct macdrv_client_surface *macdrv_client_surface_create(HWND hwnd);
+extern __attribute__((visibility("default"))) struct macdrv_client_surface *macdrv_client_surface_create(HWND hwnd);
 
 extern struct macdrv_win_data *get_win_data(HWND hwnd);
 extern void release_win_data(struct macdrv_win_data *data);
diff --git a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
index 38180847..d36584b3 100644
--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -522,11 +522,11 @@ extern void macdrv_order_cocoa_window(macdrv_window w, macdrv_window prev,
 extern void macdrv_set_view_hidden(macdrv_view v, bool hidden);
 extern void macdrv_add_view_opengl_context(macdrv_view v, macdrv_opengl_context c);
 extern void macdrv_remove_view_opengl_context(macdrv_view v, macdrv_opengl_context c);
-extern macdrv_metal_device macdrv_create_metal_device(void);
-extern void macdrv_release_metal_device(macdrv_metal_device d);
-extern macdrv_metal_view macdrv_view_create_metal_view(macdrv_view v, macdrv_metal_device d);
-extern macdrv_metal_layer macdrv_view_get_metal_layer(macdrv_metal_view v);
-extern void macdrv_view_release_metal_view(macdrv_metal_view v);
+extern __attribute__((visibility("default"))) macdrv_metal_device macdrv_create_metal_device(void);
+extern __attribute__((visibility("default"))) void macdrv_release_metal_device(macdrv_metal_device d);
+extern __attribute__((visibility("default"))) macdrv_metal_view macdrv_view_create_metal_view(macdrv_view v, macdrv_metal_device d);
+extern __attribute__((visibility("default"))) macdrv_metal_layer macdrv_view_get_metal_layer(macdrv_metal_view v);
+extern __attribute__((visibility("default"))) void macdrv_view_release_metal_view(macdrv_metal_view v);
 extern bool macdrv_get_view_backing_size(macdrv_view v, int backing_size[2]);
 extern void macdrv_set_view_backing_size(macdrv_view v, const int backing_size[2]);
 extern uint32_t macdrv_window_background_color(void);
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 7831eca7..4f560f97 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1158,15 +1158,73 @@ struct macdrv_client_surface *macdrv_client_surface_create(HWND hwnd)
     surface->cocoa_view = macdrv_create_view(cgrect_from_rect(rect));
     macdrv_set_view_hidden(surface->cocoa_view, TRUE);
 
-    if (surface)
-    {
-        macdrv_client_surface_update(&surface->client);
-        macdrv_client_surface_present(&surface->client, 0);
-    }
-
+    /* NO presentar aquí: el flujo NORMAL (GL/Vulkan y el CEF de Steam vía SwiftShader) crea la
+     * surface OCULTA y la presenta el compositor de Wine cuando toca. Forzar present aquí
+     * alteraba la jerarquía de vistas y le ROBABA el foco de teclado a la ventana (el login del
+     * CEF renderizaba pero no aceptaba input). El present para DXMT se hace explícito en
+     * macdrv_dxmt_get_client_view (que sí necesita la vista visible ya).
+     * NOTA 2026-07-02: el negro del CEF tras macOS 26.5.1 NO depende de este bloque
+     * (probado con y sin él); se mantiene quitado porque el foco de teclado del login
+     * se validó así in-vivo. */
     return surface;
 }
 
+/* DXMT/Vessel: acceso estable al cocoa_view de un client_surface, sin exponer el layout
+ * interno de `struct client_surface` (que cambia entre versiones y rompía a DXMT).
+ * Además HACE VISIBLE la vista y la reposiciona/presenta: `macdrv_client_surface_create`
+ * la crea OCULTA (para APIs que presentan por el flujo de Wine, p. ej. Vulkan). DXMT
+ * presenta el CAMetalLayer directamente por Metal, así que si la vista queda oculta el
+ * juego renderiza a una superficie invisible → pantalla NEGRA. Al desocultarla y
+ * presentar el client_surface, el layer Metal se ve sobre el área cliente de la ventana. */
+__attribute__((visibility("default")))
+macdrv_view macdrv_client_surface_get_cocoa_view(struct macdrv_client_surface *surface)
+{
+    if (!surface) return NULL;
+    macdrv_set_view_hidden(surface->cocoa_view, FALSE);
+    macdrv_client_surface_update(&surface->client);
+    macdrv_client_surface_present(&surface->client, 0);
+    return surface->cocoa_view;
+}
+
+/* DXMT/Vessel: libera el client_surface creado con macdrv_client_surface_create. */
+__attribute__((visibility("default")))
+void macdrv_client_surface_dxmt_free(struct macdrv_client_surface *surface)
+{
+    if (surface) client_surface_release(&surface->client);
+}
+
+/* DXMT/Vessel: devuelve el `client_view` REAL de la ventana (el área cliente visible y
+ * enganchada en la jerarquía de vistas). Es donde DXMT debe poner el CAMetalLayer para que
+ * se VEA — el `client_surface` es una vista separada que no siempre presenta al frente y
+ * dejaba la pantalla negra. Equivale al `client_cocoa_view` que usaba DXMT en Wine 9.9. */
+__attribute__((visibility("default")))
+macdrv_view macdrv_dxmt_get_client_view(HWND hwnd)
+{
+    struct macdrv_win_data *data = get_win_data(hwnd);
+    macdrv_view view = data ? data->client_view : NULL;
+    if (data) release_win_data(data);
+    if (view) return view;
+
+    /* No existe aún (DXMT crea el swapchain ANTES de que Wine componga el área cliente, así que
+     * `client_view` es NULL). Creamos una client_surface y la presentamos AQUÍ EXPLÍCITAMENTE
+     * (update + present) para engancharla a la ventana, hacerla VISIBLE y asignarla a
+     * data->client_view — SOLO para DXMT, sin tocar el flujo normal de otras APIs (que rompía el
+     * foco de teclado del CEF). NO la liberamos: debe persistir mientras DXMT dibuja el
+     * CAMetalLayer sobre esa vista (liberarla dispararía `destroy` → dispone la vista → negra). */
+    {
+        struct macdrv_client_surface *surface = macdrv_client_surface_create(hwnd);
+        if (surface)
+        {
+            macdrv_client_surface_update(&surface->client);
+            macdrv_client_surface_present(&surface->client, 0);
+            data = get_win_data(hwnd);
+            view = data ? data->client_view : NULL;
+            if (data) release_win_data(data);
+        }
+    }
+    return view;
+}
+
 /**********************************************************************
  *              SetDesktopWindow   (MACDRV.@)
  */
