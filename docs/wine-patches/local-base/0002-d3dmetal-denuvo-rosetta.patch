+/**********************************************************************
+ *   Tabla macdrv_functions para D3DMetal (Apple Game Porting Toolkit)
+ *
+ * D3DMetal (libd3dshared.dylib, x86_64 bajo Rosetta) hace dlsym("macdrv_functions")
+ * sobre winemac.so y espera una tabla de 24 punteros a función (192 bytes) para crear la
+ * vista Metal de una ventana y presentar. WineHQ no la exporta; Apple/CrossOver sí. La
+ * replicamos traduciendo el macdrv_win_data de 11.10 al layout de 120 bytes que D3DMetal
+ * lee por offset. Basado en dlls/winemac.drv/d3dmetal.c de CrossOver (winecx).
+ */
+#if defined(__x86_64__)
+
+#include <dispatch/dispatch.h>
+
+extern void OnMainThread(dispatch_block_t block);
+
+struct d3dmetal_macdrv_win_data
+{
+    HWND          hwnd;                 /* +0  */
+    macdrv_window cocoa_window;         /* +8  */
+    macdrv_view   cocoa_view;           /* +16 */
+    macdrv_view   client_cocoa_view;    /* +24 */
+    RECT          window_rect;          /* +32 */
+    RECT          whole_rect;           /* +48 */
+    RECT          client_rect;          /* +64 */
+    int           pixel_format;         /* +80 */
+    COLORREF      color_key;            /* +84 */
+    HANDLE        drag_event;           /* +88 */
+    unsigned int  on_screen : 1;        /* +96 */
+    unsigned int  shaped : 1;
+    unsigned int  layered : 1;
+    unsigned int  ulw_layered : 1;
+    unsigned int  per_pixel_alpha : 1;
+    unsigned int  minimized : 1;
+    unsigned int  swap_interval : 1;
+    void         *padding[2];           /* +104: padding[0] = macdrv_win_data real */
+};
+C_ASSERT(sizeof(struct d3dmetal_macdrv_win_data) == 120);
+
+static void d3dm_init_display_devices(BOOL force) { }
+
+static struct d3dmetal_macdrv_win_data *d3dm_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct d3dmetal_macdrv_win_data *d;
+    macdrv_view client_view;
+
+    /* client_view es perezoso (NULL hasta que Wine compone); D3DMetal lo pide antes.
+     * Lo forzamos con nuestro helper (crea+presenta la client_surface, visible, no libera). */
+    client_view = macdrv_dxmt_get_client_view(hwnd);
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (!(d = calloc(1, sizeof(*d)))) { release_win_data(data); return NULL; }
+
+    d->hwnd              = data->hwnd;
+    d->cocoa_window      = data->cocoa_window;
+    d->cocoa_view        = client_view ? client_view : data->client_view;
+    d->client_cocoa_view = client_view ? client_view : data->client_view;
+    d->window_rect       = data->rects.window;
+    d->whole_rect        = data->rects.visible;
+    d->client_rect       = data->rects.client;
+    d->pixel_format      = data->pixel_format;
+    d->drag_event        = data->drag_event;
+    d->on_screen         = data->on_screen;
+    d->shaped            = data->shaped;
+    d->layered           = data->layered;
+    d->ulw_layered       = data->ulw_layered;
+    d->per_pixel_alpha   = data->per_pixel_alpha;
+    d->minimized         = data->minimized;
+    d->padding[0]        = data;
+    return d;
+}
+
+static void d3dm_release_win_data(struct d3dmetal_macdrv_win_data *data)
+{
+    if (!data) return;
+    if (data->padding[0]) release_win_data(data->padding[0]);
+    free(data);
+}
+
+static macdrv_window d3dm_get_cocoa_window(HWND hwnd, BOOL on_screen)
+{   return macdrv_get_cocoa_window(hwnd, on_screen); }
+static macdrv_metal_device d3dm_create_metal_device(void)
+{   return macdrv_create_metal_device(); }
+static void d3dm_release_metal_device(macdrv_metal_device d)
+{   macdrv_release_metal_device(d); }
+static macdrv_metal_view d3dm_view_create_metal_view(macdrv_view v, macdrv_metal_device d)
+{   return macdrv_view_create_metal_view(v, d); }
+static macdrv_metal_layer d3dm_view_get_metal_layer(macdrv_metal_view v)
+{   return macdrv_view_get_metal_layer(v); }
+static void d3dm_view_release_metal_view(macdrv_metal_view v)
+{   macdrv_view_release_metal_view(v); }
+static void d3dm_on_main_thread(dispatch_block_t b)
+{   OnMainThread(b); }
+
