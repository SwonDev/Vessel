+
+static BOOL WINAPI d3dm_EnumDisplayMonitors(HDC hdc, LPRECT clip, MONITORENUMPROC proc, LPARAM lp)
+{   return NtUserEnumDisplayMonitors(hdc, clip, proc, lp); }
+static BOOL WINAPI d3dm_GetMonitorInfoA(HMONITOR m, LPMONITORINFO mi)
+{   return NtUserGetMonitorInfo(m, mi); }
+static BOOL WINAPI d3dm_AdjustWindowRectEx(LPRECT r, DWORD style, BOOL menu, DWORD ex)
+{   return NtUserAdjustWindowRect(r, style, menu, ex, NtUserGetSystemDpiForProcess(NULL)); }
+static LONG_PTR WINAPI d3dm_GetWindowLongPtrW(HWND h, int off)
+{   return NtUserGetWindowLongPtrW(h, off); }
+static BOOL WINAPI d3dm_GetWindowRect(HWND h, LPRECT r)
+{   return NtUserGetWindowRect(h, r, NtUserGetWinMonitorDpi(h, MDT_DEFAULT)); }
+static BOOL WINAPI d3dm_MoveWindow(HWND h, int x, int y, int w, int ht, BOOL rp)
+{   return NtUserMoveWindow(h, x, y, w, ht, rp); }
+static BOOL WINAPI d3dm_SetWindowPos(HWND h, HWND after, int x, int y, int w, int ht, UINT f)
+{   return NtUserSetWindowPos(h, after, x, y, w, ht, f); }
+static INT WINAPI d3dm_GetSystemMetrics(INT idx)
+{   return NtUserGetSystemMetrics(idx); }
+static LONG_PTR WINAPI d3dm_SetWindowLongPtrW(HWND h, INT off, LONG_PTR val)
+{   return NtUserSetWindowLongPtr(h, off, val, FALSE); }
+
+struct macdrv_functions_t
+{
+    void                (*init_display_devices)(BOOL);
+    struct d3dmetal_macdrv_win_data* (*get_win_data)(HWND);
+    void                (*release_win_data)(struct d3dmetal_macdrv_win_data *);
+    macdrv_window       (*get_cocoa_window)(HWND, BOOL);
+    macdrv_metal_device (*create_metal_device)(void);
+    void                (*release_metal_device)(macdrv_metal_device);
+    macdrv_metal_view   (*view_create_metal_view)(macdrv_view, macdrv_metal_device);
+    macdrv_metal_layer  (*view_get_metal_layer)(macdrv_metal_view);
+    void                (*view_release_metal_view)(macdrv_metal_view);
+    void                (*on_main_thread)(dispatch_block_t);
+    LONG (WINAPI *RegQueryValueExA)(HKEY, LPCSTR, LPDWORD, LPDWORD, BYTE*, LPDWORD);
+    LONG (WINAPI *RegSetValueExA)(HKEY, LPCSTR, DWORD, DWORD, const BYTE*, DWORD);
+    LONG (WINAPI *RegOpenKeyExA)(HKEY, LPCSTR, DWORD, DWORD, HKEY*);
+    LONG (WINAPI *RegCreateKeyExA)(HKEY, LPCSTR, DWORD, LPSTR, DWORD, DWORD, void*, HKEY*, LPDWORD);
+    LONG (WINAPI *RegCloseKey)(HKEY);
+    BOOL     (WINAPI *EnumDisplayMonitors)(HDC, LPRECT, MONITORENUMPROC, LPARAM);
+    BOOL     (WINAPI *GetMonitorInfoA)(HMONITOR, LPMONITORINFO);
+    BOOL     (WINAPI *AdjustWindowRectEx)(LPRECT, DWORD, BOOL, DWORD);
+    LONG_PTR (WINAPI *GetWindowLongPtrW)(HWND, int);
+    BOOL     (WINAPI *GetWindowRect)(HWND, LPRECT);
+    BOOL     (WINAPI *MoveWindow)(HWND, int, int, int, int, BOOL);
+    BOOL     (WINAPI *SetWindowPos)(HWND, HWND, int, int, int, int, UINT);
+    INT      (WINAPI *GetSystemMetrics)(INT);
+    LONG_PTR (WINAPI *SetWindowLongPtrW)(HWND, INT, LONG_PTR);
+};
+
+/* Símbolo de datos global que D3DMetal busca con dlsym. visibility=default + used. */
+__attribute__((visibility("default"), used))
+struct macdrv_functions_t macdrv_functions =
+{
+    d3dm_init_display_devices, d3dm_get_win_data, d3dm_release_win_data,
+    d3dm_get_cocoa_window,
+    d3dm_create_metal_device, d3dm_release_metal_device,
+    d3dm_view_create_metal_view, d3dm_view_get_metal_layer, d3dm_view_release_metal_view,
+    d3dm_on_main_thread,
+    d3dm_RegQueryValueExA, d3dm_RegSetValueExA, d3dm_RegOpenKeyExA, d3dm_RegCreateKeyExA, d3dm_RegCloseKey,
+    d3dm_EnumDisplayMonitors, d3dm_GetMonitorInfoA, d3dm_AdjustWindowRectEx,
+    d3dm_GetWindowLongPtrW, d3dm_GetWindowRect, d3dm_MoveWindow, d3dm_SetWindowPos,
+    d3dm_GetSystemMetrics, d3dm_SetWindowLongPtrW,
+};
+C_ASSERT(sizeof(macdrv_functions) == 192);
+
+#endif /* __x86_64__ */
