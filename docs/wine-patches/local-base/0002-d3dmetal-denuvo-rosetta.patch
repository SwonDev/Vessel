diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index a42be942..e457ff24 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -793,7 +793,9 @@ static inline struct thread_data *init_handler( void *sigcontext )
     amd64_data->syscall_dispatch = 0; /* SYSCALL_DISPATCH_FILTER_ALLOW */
     if (fs32_sel) arch_prctl( ARCH_SET_FS, amd64_data->pthread_teb );
 #elif defined __APPLE__
-    _thread_set_tsd_base( (uint64_t)amd64_data->pthread_teb );
+    /* Modelo CrossOver: el GSBASE ya es la base pthread (nunca lo movemos), así que el
+     * handler NO lo toca. Antes, poner el gsbase con un valor derivado de rsp&~mask
+     * corrompía los hilos nativos de D3DMetal. */
 
     /* When in a syscall, CS will be the kernel's selector (0x07, SYSCALL_CS in xnu source)
      * instead of the user selector (cs64_sel: 0x2b, USER64_CS).
@@ -824,9 +826,11 @@ static inline void leave_handler( struct thread_data *data, ucontext_t *sigconte
         if (fs32_sel) __asm__ volatile( "movw %0,%%fs" :: "r" (fs32_sel) );
     }
 #elif defined __APPLE__
-    if (!is_inside_signal_stack( data, (void *)RSP_sig(sigcontext )) &&
-        !is_inside_syscall( data, RSP_sig(sigcontext )))
-        _thread_set_tsd_base( (uint64_t)data->teb );
+    /* Modelo CrossOver: el GSBASE es siempre la base pthread; NO lo reponemos a TEB al salir
+     * del handler (el código PE alcanza el TEB por %gs:0x30). Reponerlo con data->teb
+     * (derivado de rsp&~mask) corrompía el gsbase de los hilos nativos de D3DMetal.
+     * El código PE lee Peb/TLS por indirección desde %gs:0x30 (slot 6 reservado), así que
+     * NO tocamos %gs:0x58/0x60 (slot 12 = localtime de la libc; escribirlo lo corrompe). */
 #endif
     if (is_16bit( sigcontext )) return;
 #ifdef DS_sig
@@ -1043,8 +1047,23 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
     {
         ret = set_thread_context( handle, context, &self, IMAGE_FILE_MACHINE_AMD64 );
 #ifdef __APPLE__
+        /* Bajo Rosetta los debug registers de HW (DR0-DR7) no se pueden fijar y el server call
+         * falla con STATUS_UNSUCCESSFUL. Los anti-tamper como Denuvo los fijan y COMPRUEBAN el
+         * resultado: si ven el error, deducen que el entorno no es Windows nativo y toman su ruta de
+         * faults deliberados (que en nuestro Wine descarrila y cuelga/crashea el juego). Igual que
+         * hace CrossOver ("faking success"), FINGIMOS ÉXITO y guardamos los valores en el thread_data
+         * para que NtGetContextThread los devuelva coherentes (Denuvo también los relee). */
         if ((flags & CONTEXT_DEBUG_REGISTERS) && (ret == STATUS_UNSUCCESSFUL))
-            WARN_(seh)( "Setting debug registers is not supported under Rosetta\n" );
+        {
+            WARN_(seh)( "Setting debug registers is not supported under Rosetta, faking success\n" );
+            amd64_data->dr0 = context->Dr0;
+            amd64_data->dr1 = context->Dr1;
+            amd64_data->dr2 = context->Dr2;
+            amd64_data->dr3 = context->Dr3;
+            amd64_data->dr6 = context->Dr6;
+            amd64_data->dr7 = context->Dr7;
+            return STATUS_SUCCESS;
+        }
 #endif
         if (ret || !self) return ret;
         if (flags & CONTEXT_DEBUG_REGISTERS)
@@ -1684,12 +1703,7 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "movw %ax,%fs\n"
                    "1:\n\t"
 #elif defined __APPLE__
-                   "movq %rcx,%r10\n\t"
-                   "movq %r13,%rdi\n\t"
-                   "xorl %esi,%esi\n\t"
-                   "movl $0x3000003,%eax\n\t"  /* _thread_set_tsd_base */
-                   "syscall\n\t"
-                   "movq %r10,%rcx\n\t"
+                   /* Modelo CrossOver: sin switch de gsbase; el TEB ya está en %r13. */
 #endif
                    "movq 0x330(%r13),%r10\n\t" /* amd64_thread_data()->instrumentation_callback */
                    "movq (%r10),%r10\n\t"
@@ -2873,7 +2887,24 @@ void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, TEB *teb )
 #elif defined(__NetBSD__)
     sysarch( X86_64_SET_GSBASE, &teb );
 #elif defined (__APPLE__)
+    /* Modelo CrossOver: NO movemos el GSBASE (queda = base pthread nativa que ya trae el
+     * hilo). El código PE alcanza el TEB por indirección %gs:0x30, así que guardamos en
+     * slots de la TSD de pthread (a los offsets naturales del TEB) los punteros que el
+     * código traducido lee por %gs directo. Así los hilos NATIVOS de D3DMetal conservan su
+     * %gs válido bajo Rosetta y no se corrompen. */
     thread_data->pthread_teb = mac_thread_gsbase();
+    teb->Instrumentation[0] = thread_data->pthread_teb;   /* gsbase del hilo (para actualizar su TSD desde el loader) */
+    /* Guardamos Self (slot 6) y TLS (slot 11): Apple los reserva para Win64, son estables y el
+     * código PE los lee por %gs:0x30/0x58. NO guardamos el Peb en %gs:0x60: ese slot es
+     * __PTK_LIBC_LOCALTIME_KEY (lo usa localtime() de la libc), y escribir el puntero PEB ahí
+     * hace que localtime() escriba su resultado DENTRO del PEB → lo corrompe. El Peb se lee
+     * siempre por indirección desde %gs:0x30 (ver dlls/ntdll/signal_x86_64.c). */
+    __asm__ volatile( "movq %0,%%gs:0x30" :: "r" (teb->Tib.Self) );
+    __asm__ volatile( "movq %0,%%gs:0x58" :: "r" (teb->ThreadLocalStoragePointer) );
+    /* VESSEL: TEST — escribir el PEB en %gs:0x60. Código Windows de terceros (anti-tamper como
+     * Denuvo) lee el PEB por %gs:0x60 DIRECTO (en Windows gsbase=TEB → %gs:0x60=TEB.Peb). Sin esto
+     * obtienen el slot localtime (basura) y derivan. Riesgo: localtime() usa ese slot; a evaluar. */
+    __asm__ volatile( "movq %0,%%gs:0x60" :: "r" (teb->Peb) );
 #else
 # error Please define setting %gs for your architecture
 #endif
@@ -2982,7 +3013,8 @@ __ASM_GLOBAL_FUNC( signal_start_thread,
  */
 __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_gs_load") ":\n\t"
-                   "movq %gs:0x378,%rcx\n\t"       /* thread_data->syscall_frame */
+                   "movq %gs:0x30,%rcx\n\t"        /* TEB (modelo CrossOver: %gs=base pthread) */
+                   "movq 0x378(%rcx),%rcx\n\t"     /* thread_data->syscall_frame */
                    "popq 0x70(%rcx)\n\t"           /* frame->rip */
                    __ASM_CFI(".cfi_adjust_cfa_offset -8\n\t")
                    __ASM_CFI_REG_IS_AT2(rip, rcx, 0xf0,0x00)
@@ -3085,10 +3117,7 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "leaq -0x98(%rbp),%rcx\n"
                    "2:\n\t"
 #elif defined __APPLE__
-                   "movq 0x320(%r13),%rdi\n\t"     /* amd64_thread_data()->pthread_teb */
-                   "xorl %esi,%esi\n\t"
-                   "movl $0x3000003,%eax\n\t"      /* _thread_set_tsd_base */
-                   "syscall\n\t"
+                   /* Modelo CrossOver: sin switch de gsbase (ya es la base pthread). */
                    "leaq -0x98(%rbp),%rcx\n"
 #endif
                    "ldmxcsr 0x33c(%r13)\n\t"       /* amd64_thread_data()->mxcsr */
@@ -3138,14 +3167,7 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "movw %dx,%fs\n"
                    "1:\n\t"
 #elif defined __APPLE__
-                   "movq %rax,%r8\n\t"
-                   "movq %rcx,%rdx\n\t"
-                   "movq %r13,%rdi\n\t"            /* teb */
-                   "xorl %esi,%esi\n\t"
-                   "movl $0x3000003,%eax\n\t"      /* _thread_set_tsd_base */
-                   "syscall\n\t"
-                   "movq %rdx,%rcx\n\t"
-                   "movq %r8,%rax\n\t"
+                   /* Modelo CrossOver: sin switch de gsbase a la salida (queda base pthread). */
 #endif
                    "movl 0xb4(%rcx),%edx\n\t"      /* frame->restore_flags */
                    "testl $0x48,%edx\n\t"          /* CONTEXT_FLOATING_POINT | CONTEXT_XSTATE */
@@ -3293,7 +3315,8 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher_return,
                    "jmp " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_return") )
 
