@@ -838,7 +839,8 @@ __ASM_GLOBAL_FUNC( RtlRaiseException,
                    "movq %rax,0xf8(%rdx)\n\t"   /* context->Rip */
                    "movq %rax,0x10(%rcx)\n\t"   /* rec->ExceptionAddress */
                    "movl $1,%r8d\n\t"
-                   "movq %gs:0x60,%rax\n\t"     /* Peb */
+                   "movq %gs:0x30,%rax\n\t"     /* NtCurrentTeb() (slot 6 reservado, estable) */
+                   "movq 0x60(%rax),%rax\n\t"   /* Peb (indirección; %gs:0x60/slot 12 = localtime) */
                    "cmpb $0,0x02(%rax)\n\t"     /* BeingDebugged */
                    "jne 1f\n\t"
                    "call " __ASM_NAME("dispatch_exception") "\n"
@@ -1082,7 +1084,8 @@ __ASM_GLOBAL_FUNC( DbgUiRemoteBreakin,
                    ".seh_stackalloc 0x28\n\t"
                    ".seh_endprologue\n\t"
                    ".seh_handler DbgUiRemoteBreakin_handler, @except\n\t"
-                   "mov %gs:0x60,%rax\n\t"
+                   "mov %gs:0x30,%rax\n\t"      /* NtCurrentTeb() (slot 6 estable) */
+                   "mov 0x60(%rax),%rax\n\t"    /* Peb (indirección) */
                    "cmpb $0,2(%rax)\n\t"
                    "je 1f\n\t"
