diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index b19bf78a..6c317b83 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -72,6 +72,16 @@ static void __fastcall default_thread_init_func( DWORD unknown, LPTHREAD_START_R
 void (FASTCALL *pBaseThreadInitThunk)(DWORD,LPTHREAD_START_ROUTINE,void *) = default_thread_init_func;
 NTSTATUS (WINAPI *__wine_unix_call_dispatcher)( unixlib_handle_t, unsigned int, void * ) = NULL;
 
+/* Compat: el export directo __wine_unix_call se eliminó tras Wine 9.0 (ahora es un
+ * `static inline` en wine/unixlib.h), pero los builtins D3DMetal de Apple (GPTK,
+ * compilados contra Wine 9.0) lo importan por nombre de ntdll. Restauramos el
+ * export como envoltorio del dispatcher (aliaseado a __wine_unix_call en el .spec)
+ * para poder cargar d3d12/dxgi de D3DMetal en este motor (Wine 11.10). */
+NTSTATUS WINAPI wine_export_unix_call( unixlib_handle_t handle, unsigned int code, void *args )
+{
+    return __wine_unix_call_dispatcher( handle, code, args );
+}
+
 static DWORD (WINAPI *pCtrlRoutine)(void *);
 
 SYSTEM_DLL_INIT_BLOCK LdrSystemDllInitBlock = { 0xf0 };
@@ -1392,6 +1402,11 @@ static BOOL alloc_tls_slot( LDR_DATA_TABLE_ENTRY *mod )
             if (!new) return FALSE;
             if (old) memcpy( new, old, old_module_count * sizeof(*new) );
             teb->ThreadLocalStoragePointer = new;
+            /* Modelo CrossOver (macOS): el %gs es la base pthread y el código PE lee el TLS por
+             * %gs:0x58 directo. Actualizamos el slot TSD del hilo destino (su gsbase está en
+             * Instrumentation[0]). En el resto de plataformas Instrumentation[0]=0 → no-op. */
+            if (teb->Instrumentation[0])
+                *(void **)((char *)teb->Instrumentation[0] + 0x58) = new;
             TRACE( "thread %04lx tls block %p -> %p\n", HandleToULong(teb->ClientId.UniqueThread), old, new );
             /* FIXME: can't free old block here, should be freed at thread exit */
         }
@@ -1637,6 +1652,9 @@ static NTSTATUS alloc_thread_tls(void)
         TRACE( "slot %u: %u/%lu bytes at %p\n", i, size, dir->SizeOfZeroFill, pointers[i] );
     }
     NtCurrentTeb()->ThreadLocalStoragePointer = pointers;
+    /* Modelo CrossOver (macOS): sincronizar el slot %gs:0x58 del hilo actual. */
+    if (NtCurrentTeb()->Instrumentation[0])
+        __asm__ volatile( "movq %0,%%gs:0x58" :: "r" (pointers) );
     return STATUS_SUCCESS;
 }
 
