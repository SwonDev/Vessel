diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index ed39420b..1a5f5b67 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -189,6 +189,13 @@ extern BOOL macdrv_SystemParametersInfo(UINT action, UINT int_param, void *ptr_p
     unsigned int        per_pixel_alpha : 1;    /* is window using per-pixel alpha? */
     unsigned int        minimized : 1;          /* is window minimized? */
     unsigned int        fullscreen : 1;         /* is the window visible rect fullscreen? (unrelated to native AppKit/Cocoa fullscreen) */
+
+    /* CW HACK 22435 (Vessel): retiene TODAS las client surfaces de la ventana — una por cada
+     * swapchain del compositor del CEF de Steam (cliente, biblioteca y TIENDA). Cada surface tiene
+     * su propio cocoa_view + CAMetalLayer, todas anidadas y visibles a la vez, para que la tienda
+     * (que renderiza en un swapchain aparte) NO quede negra. Sin este array los swapchains
+     * compartían un único `client_view` y se pisaban. Se libera en macdrv_DestroyWindow. */
+    CFMutableArrayRef   d3dmetal_client_surfaces;
