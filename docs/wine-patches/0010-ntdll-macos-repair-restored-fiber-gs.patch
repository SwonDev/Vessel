+#ifdef __APPLE__
+static __uint64_t *macos_x64_context_register( ucontext_t *ucontext, unsigned int index )
+{
+    switch (index)
+    {
+    case 0:  return &RAX_sig(ucontext);
+    case 1:  return &RCX_sig(ucontext);
+    case 2:  return &RDX_sig(ucontext);
+    case 3:  return &RBX_sig(ucontext);
+    case 5:  return &RBP_sig(ucontext);
+    case 6:  return &RSI_sig(ucontext);
+    case 7:  return &RDI_sig(ucontext);
+    case 8:  return &R8_sig(ucontext);
+    case 9:  return &R9_sig(ucontext);
+    case 10: return &R10_sig(ucontext);
+    case 11: return &R11_sig(ucontext);
+    case 13: return &R13_sig(ucontext);
+    case 14: return &R14_sig(ucontext);
+    case 15: return &R15_sig(ucontext);
+    default: return NULL;
+    }
+}
+
+/*
+ * Some protected executables restore their original code after loader-time
+ * patching. If the immediately preceding instruction is the canonical MSVC
+ * GetCurrentFiber() read from gs:[0x20], macOS has put its pthread QoS value
+ * in the destination register instead of the Windows FiberData pointer. The
+ * following dereference then faults. Repair only that register and retry the
+ * faulting instruction; no executable code or on-disk file is modified.
+ */
+static BOOL repair_macos_restored_fiber_gs_read( ucontext_t *ucontext,
+                                                 const EXCEPTION_RECORD *rec )
+{
+    BYTE instruction[9];
+    const BYTE *rip = (const BYTE *)RIP_sig(ucontext);
+    __uint64_t *value;
+    void *fiber_data;
+    unsigned int index;
+
+    if (!vessel_macos_fiber_gs_rewrite || CS_sig(ucontext) != cs64_sel
+        || rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION
+        || rec->NumberParameters < 2
+        || rec->ExceptionInformation[0] != EXCEPTION_READ_FAULT
+        || (ULONG_PTR)rip < sizeof(instruction))
+        return FALSE;
+    if (virtual_uninterrupted_read_memory( rip - sizeof(instruction), instruction,
+                                           sizeof(instruction) ) != sizeof(instruction))
+        return FALSE;
+    if (instruction[0] != 0x65
+        || (instruction[1] != 0x48 && instruction[1] != 0x4c)
+        || instruction[2] != 0x8b || (instruction[3] & 0xc7) != 0x04
+        || instruction[4] != 0x25 || instruction[5] != 0x20
+        || instruction[6] || instruction[7] || instruction[8])
+        return FALSE;
+
+    index = ((instruction[1] & 0x04) ? 8 : 0) + ((instruction[3] >> 3) & 7);
+    if (!(value = macos_x64_context_register( ucontext, index ))) return FALSE;
+    if (*value != rec->ExceptionInformation[1]) return FALSE;
+    if (!(fiber_data = NtCurrentTeb()->Tib.FiberData)
+        || (ULONG_PTR)fiber_data == *value)
+        return FALSE;
+
+    TRACE_(seh)( "repairing restored gs:[0x20] fiber read at %p: r%u %p -> %p\n",
+                 rip - sizeof(instruction), index, (void *)*value, fiber_data );
+    *value = (ULONG_PTR)fiber_data;
     return TRUE;
 }
+#endif
 
 
